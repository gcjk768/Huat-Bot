# Huat Bot settings for docker compose. Copy this file to .env and fill it in.
# The jackpot alert and history window live in Settings.md inside the vault, not here.

# Bot token from @BotFather in Telegram, such as 123456789:AAH... (keep it secret)
TELEGRAM_BOT_TOKEN=
# Where to post: @yourchannel for a public channel, or the numeric id of a private channel (starts with -100)
TELEGRAM_CHAT_ID=
# Your Obsidian vault folder on the NAS, mounted into the container as /vault
VAULT_HOST_PATH=/volume1/Obsidian/MyVault
# Folder inside the vault where the bot keeps all its notes and data (created on the first run)
VAULT_FOLDER=Huat Bot
# Your NAS user id (run the id command over SSH), the bot writes files as this user
PUID=1000
# Your NAS group id (run the id command over SSH), usually 10 (admin) on UGOS
PGID=10
# Time to run on draw days, 24 hour clock, Singapore time
RUN_AT=19:30
# Minutes between checks while a new result is not on the site yet
RETRY_MINUTES=10
# Hours to keep checking before giving up and sending a short notice instead
RETRY_HOURS=2
# 1 prints the two messages to the log instead of posting them (0 posts to Telegram)
DRY_RUN=0
# off, or claude to add a short comment written by claude -p from the computed figures
COMMENTARY=off
# true builds the image with Node.js and the Claude Code CLI, needed only for COMMENTARY=claude (rebuild after changing)
INSTALL_CLAUDE=false
# Anthropic API key for claude -p, only needed if COMMENTARY=claude
ANTHROPIC_API_KEY=
# How much detail goes into the container log: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
